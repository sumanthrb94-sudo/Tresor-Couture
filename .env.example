# Tresor Couture — environment template.
# Copy to .env (gitignored) for local builds; set the same vars in Vercel
# under Project → Settings → Environment Variables. DO NOT commit real secrets.

# Gate for the /admin and /admin/brand-kit routes. Override the default
# 'tresor-atelier' before going live. NOT real security — the gate hides
# admin tools from shoppers. Protect destructive operations server-side
# once a backend is wired up.
VITE_ADMIN_PASSCODE=

# Public-facing URL of the deployment. Used by SEO meta tags + sitemap.
VITE_PUBLIC_URL=https://tresor-couture.vercel.app

# ─────────────────────────────────────────────────────────────────────────
# Payments — Razorpay
# ─────────────────────────────────────────────────────────────────────────
# Real payments are OPT-IN and credential-gated. Leave every variable below
# blank and the app keeps running its demo checkout (no real funds move).
# Set them ALL to switch the storefront to live Razorpay payments.
#
# Where each is used:
#   - VITE_*       → bundled into the browser build (PUBLIC, never secret).
#   - everything else → server-only (Vercel serverless functions in /api).
#     NEVER prefix a secret with VITE_ — that would expose it to shoppers.

# PUBLIC Razorpay key id (starts rzp_test_… or rzp_live_…). Read by the
# client (src/lib/payments.ts) to decide real-vs-demo mode and to open the
# Razorpay Checkout modal. Same value as RAZORPAY_KEY_ID below — safe to expose.
VITE_RAZORPAY_KEY_ID=

# SERVER Razorpay key id + secret. Used by /api/payments/* to create orders
# and verify payment signatures. The SECRET must never reach the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SERVER webhook signing secret. Set this to the same secret you configure in
# the Razorpay Dashboard → Settings → Webhooks when registering
# https://<your-domain>/api/payments/webhook for the `payment.captured` event.
RAZORPAY_WEBHOOK_SECRET=

# SERVER Firebase Admin credentials. Required so the serverless functions can
# read authoritative product prices and write paid orders / decrement stock.
# Paste the ENTIRE service-account JSON (Firebase Console → Project Settings →
# Service accounts → Generate new private key) as a single-line value. On
# Vercel, paste the raw JSON; literal "\n" inside private_key are handled.
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to a JSON file path locally.
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ─────────── Brevo (marketing email engine) ───────────
# SERVER Brevo API key. Powers /api/subscribers/sync, which upserts newsletter
# / WhatsApp opt-ins into Brevo contacts so campaigns + automations authored in
# Brevo have a live audience. Firestore `subscribers` stays the source of truth.
# Get it at Brevo → SMTP & API → API Keys. Never expose to the browser.
# Leave blank to disable the sync (the form still captures leads to Firestore).
BREVO_API_KEY=
# Optional: numeric Brevo list id to add synced contacts to (Brevo → Contacts →
# Lists → the list's id). If unset, contacts are created without a list.
BREVO_LIST_ID=
