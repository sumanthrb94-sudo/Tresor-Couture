# Tresor Couture — environment template.
# Copy to .env (gitignored) for local builds; set the same vars in Vercel
# under Project → Settings → Environment Variables. DO NOT commit real secrets.

# Gate for the /admin and /admin/brand-kit routes. Override the default
# 'tresor-atelier' before going live. NOT real security — the gate hides
# admin tools from shoppers. Protect destructive operations server-side
# once a backend is wired up.
VITE_ADMIN_PASSCODE=

# Public-facing URL of the deployment. Used by SEO meta tags + sitemap.
VITE_PUBLIC_URL=https://tresor-couture.vercel.app

# ── Analytics (client) ──────────────────────────────────────────────
# GA4 / Firebase Analytics. Already wired via the Firebase config; override
# only if pointing at a different property. (Disabled automatically on localhost.)
VITE_FIREBASE_MEASUREMENT_ID=G-RT2P8RC6RN

# ── Brevo email (SERVER-ONLY — set in Vercel, never prefix VITE_) ────
# Transactional order emails + marketing contact capture run in /api functions.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=orders@tresorcouture.in
BREVO_SENDER_NAME=Tresor Couture
# Numeric id of the Brevo contact list new subscribers are added to.
BREVO_LIST_ID=

# Firebase project id used by the serverless functions to verify ID tokens
# (keyless — no service-account key needed). Defaults to 'tresor-couture'.
FIREBASE_PROJECT_ID=tresor-couture

# ── WhatsApp (Meta Cloud API) — SERVER-ONLY, added later ────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Payment gateway (Cashfree) — SERVER-ONLY, wired last ────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST
