# Tresor Couture — environment template.
# Copy to .env.local (gitignored) for local builds; set the same vars in Vercel
# under Project → Settings → Environment Variables. DO NOT commit real secrets.

# ── Public app URL (client) ─────────────────────────────────────────
# Used by password-reset links, SEO meta tags, and sitemap generation.
VITE_PUBLIC_APP_URL=https://tresorcouture.in

# ── Firebase client config (VITE_ prefix = exposed to browser) ───────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tresor-couture.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tresor-couture
VITE_FIREBASE_STORAGE_BUCKET=tresor-couture.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# GA4 / Firebase Analytics. Optional; omit if not configured.
VITE_FIREBASE_MEASUREMENT_ID=

# ── Razorpay (client + server) ──────────────────────────────────────
# Public checkout key id (browser opens Razorpay with this). Safe to expose.
VITE_RAZORPAY_KEY_ID=
# Server key id + secret — create the order + verify signatures. Secret never
# reaches the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Server webhook signing secret — set to the same secret configured in
# Razorpay Dashboard → Settings → Webhooks for /api/payments/webhook
# (event: payment.captured).
RAZORPAY_WEBHOOK_SECRET=

# ── Brevo email (SERVER-ONLY — set in Vercel, never prefix VITE_) ────
# Transactional order emails + marketing contact capture run in /api functions.
BREVO_API_KEY=
# Must be a REAL monitored mailbox on the authenticated domain — customers reply
# to order confirmations. no-reply@/orders@ are not provisioned, so replies to
# them are lost. Provisioned: care@, hello@, studio@ (tresorcouture.in).
BREVO_SENDER_EMAIL=care@tresorcouture.in
BREVO_SENDER_NAME=Tresor Couture
# Numeric id of the Brevo contact list new subscribers are added to.
BREVO_LIST_ID=
# Optional numeric template id for the welcome email.
BREVO_WELCOME_TEMPLATE_ID=

# ── WhatsApp (Meta Cloud API) — SERVER-ONLY, added later ────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_ADMIN_TO=
WHATSAPP_LANG=en

# ── Payment gateway (Cashfree) — SERVER-ONLY, wired last ────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# ── CORS / origin allowlist ─────────────────────────────────────────
# Comma-separated list of origins allowed to call /api/* endpoints.
# Must include the production domain and any Vercel preview domains you use.
ALLOWED_ORIGIN=https://tresorcouture.in,https://www.tresorcouture.in

# ── Upstash Redis (global rate limiting) ────────────────────────────
# Optional but strongly recommended for production. If omitted, rate limiting
# falls back to per-instance in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── hCaptcha (bot protection on public forms) ───────────────────────
# Public site key — exposed to the browser.
VITE_HCAPTCHA_SITE_KEY=
# Secret key — server-side only.
HCAPTCHA_SECRET=

# ── Sentry (error tracking) ─────────────────────────────────────────
# Public DSN — safe to expose in the browser bundle.
VITE_SENTRY_DSN=
# Build-time auth token for source-map upload — server-side only.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Firebase server config ──────────────────────────────────────────
# Firebase project id used by serverless functions and scripts.
FIREBASE_PROJECT_ID=tresor-couture
# Server Firebase Admin credentials for /api/payments/*, /api/orders/*,
# and seed scripts. Paste the full service-account JSON, OR rely on keyless ADC
# with GOOGLE_APPLICATION_CREDENTIALS if your org blocks key creation.
FIREBASE_SERVICE_ACCOUNT=
# Alternative to FIREBASE_SERVICE_ACCOUNT: path to a service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Legal business identity (client) ────────────────────────────────
# Real registration details for GST invoices and policy pages. Placeholders are
# invalid for production; set these before going live. Admin → Compliance
# validates them and cross-checks the GSTIN against the PAN and state code.
# NOTE: these are baked in at build time — redeploy after changing them.
VITE_LEGAL_NAME=
# 15 chars: 2-digit state code + PAN + entity code + 'Z' + checksum.
VITE_GSTIN=
# 10 chars. The 4th character encodes entity type (P=individual, F=firm/LLP,
# C=company, T=trust, H=HUF...) and must agree with VITE_LEGAL_NAME.
VITE_PAN=
# Registered place of business, PIPE-separated lines (commas appear inside the
# lines). Printed on every invoice.
#   "Tresor Atelier|12-3-45 Some Road|Hyderabad, Telangana 500034|India"
VITE_BUSINESS_ADDRESS=
# Customer-facing contact address shown on invoices and the Contact page.
# Defaults to hello@tresorcouture.in. Do NOT use a tresorcouture.com address —
# that domain is not owned by the business and mail to it bounces.
VITE_BUSINESS_EMAIL=
# CIN for a company, LLPIN for an LLP. Leave blank for a partnership firm or
# sole proprietorship — they have neither.
VITE_CIN=

# ── Admin seed credentials (scripts/seed-firestore.ts) ──────────────
# If provided, the seed script creates/resets this admin user and grants the
# admin custom claim. If omitted, seed skips admin creation and you can use
# `npm run set-admin -- <email>` instead.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ── E2E test credentials (do not commit real values) ────────────────
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_USER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
