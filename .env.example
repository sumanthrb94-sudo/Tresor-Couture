# Tresor Couture — environment template.
# Copy to .env (gitignored) for local builds; set the same vars in Vercel
# under Project → Settings → Environment Variables. DO NOT commit real secrets.

# Gate for the /admin and /admin/brand-kit routes. Override the default
# 'tresor-atelier' before going live. NOT real security — the gate hides
# admin tools from shoppers. Protect destructive operations server-side
# once a backend is wired up.
VITE_ADMIN_PASSCODE=

# Public-facing URL of the deployment. Used by SEO meta tags + sitemap.
VITE_PUBLIC_URL=https://tresor-couture.vercel.app

# ---------------------------------------------------------------------------
# Firebase Cloud Functions — set via `firebase functions:secrets:set` or
# in GCP Secret Manager. Never put real values in this file.
# ---------------------------------------------------------------------------

# Canonical app URL used in outgoing emails (no trailing slash).
APP_URL=https://tresorcouture.com

# "From" address for transactional email sent through the Trigger Email
# extension. Must be a verified sender in your SMTP provider.
USESEND_FROM_EMAIL=hello@tresorcouture.com

# useSend API — your Cloud Run deployment URL (no trailing slash).
USESEND_API_URL=https://usesend-xxxx-uc.a.run.app

# useSend API key (generate in the useSend dashboard → Settings → API Keys).
USESEND_API_KEY=

# useSend list ID to add new sign-ups to (copy from the Lists page).
USESEND_LIST_ID=
