{
  "name": "tresor-couture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "seed": "tsx scripts/seed-firestore.ts",
    "seed:force": "tsx scripts/seed-firestore.ts --force",
    "seed:pptx-catalogue": "tsx scripts/seed-pptx-catalogue.ts",
    "seed:pptx-catalogue:dry": "tsx scripts/seed-pptx-catalogue.ts --dry-run",
    "seed:full-catalogue": "tsx scripts/seed-full-catalogue.ts",
    "seed:full-catalogue:dry": "tsx scripts/seed-full-catalogue.ts --dry-run",
    "set-admin": "tsx scripts/set-admin.ts",
    "open:signed-in-chrome": "npx tsx scripts/open-signed-in-chrome.ts",
    "open:signed-in-cdp": "npx tsx scripts/open-signed-in-cdp.ts",
    "test:e2e:signed-in": "npx playwright test tests/e2e/signed-in --project=signed-in-chrome --workers=1",
    "test:e2e:signed-in:cdp": "set CDP_URL=http://localhost:9222 && npx playwright test tests/e2e/signed-in --project=signed-in-chrome --workers=1",
    "test:e2e:signed-in:smoke": "npx playwright test tests/e2e/signed-in/signed-in-smoke.spec.ts --project=signed-in-chrome --workers=1",
    "test:e2e:signed-in:lifecycle": "npx playwright test tests/e2e/signed-in/signed-in-lifecycle.spec.ts --project=signed-in-chrome --workers=1"
  },
  "dependencies": {
    "@sentry/node": "^10.63.0",
    "@sentry/react": "^10.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "axios": "^1.18.1",
    "websocket-driver": "^0.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.0",
    "typescript": "~5.8.2"
  }
}
