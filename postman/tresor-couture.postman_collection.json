{
  "info": {
    "name": "Tresor Couture · Free-Tier Backend",
    "_postman_id": "trsr-couture-firebase-free",
    "description": "Talks directly to Firebase Identity Toolkit + Firestore REST against the tresor-couture project.\n\nThe collection-level pre-request hook generates a unique testEmail/testPassword per run so Newman re-runs do not collide with the previous user.\n\n**Run with Newman:** `npx newman run postman/tresor-couture.postman_collection.json -e postman/tresor-couture.postman_environment.json`\n\n**Admin-only requests** (product CRUD, coupon write, order admin update, review approve) are sent with the regular {{idToken}} and ASSERT 403 — that proves firestore.rules is correctly denying non-admin writes. If you have an admin custom-claim token, populate {{adminIdToken}} and switch the Authorization header back to test the success path.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{idtBase}}/accounts:signUp?key={{apiKey}}",
              "host": [
                "{{idtBase}}"
              ],
              "path": [
                "accounts:signUp"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{apiKey}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"returnSecureToken\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.idToken)      pm.environment.set('idToken',      b.idToken);",
                  "if (b.refreshToken) pm.environment.set('refreshToken', b.refreshToken);",
                  "if (b.localId)      pm.environment.set('uid',          b.localId);",
                  "pm.test('200 OK',           () => pm.response.to.have.status(200));",
                  "pm.test('idToken captured', () => pm.expect(b.idToken).to.be.a('string').and.have.length.greaterThan(20));",
                  "pm.test('localId captured', () => pm.expect(b.localId).to.be.a('string'));",
                  "pm.test('email echo',       () => pm.expect(b.email).to.eql(pm.environment.get('testEmail')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{idtBase}}/accounts:signInWithPassword?key={{apiKey}}",
              "host": [
                "{{idtBase}}"
              ],
              "path": [
                "accounts:signInWithPassword"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{apiKey}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"returnSecureToken\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.idToken)      pm.environment.set('idToken',      b.idToken);",
                  "if (b.refreshToken) pm.environment.set('refreshToken', b.refreshToken);",
                  "if (b.localId)      pm.environment.set('uid',          b.localId);",
                  "pm.test('200 OK',           () => pm.response.to.have.status(200));",
                  "pm.test('idToken refreshed',() => pm.expect(b.idToken).to.be.a('string'));",
                  "pm.test('uid stable',       () => pm.expect(b.localId).to.eql(pm.environment.get('uid')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "https://securetoken.googleapis.com/v1/token?key={{apiKey}}",
              "host": [
                "https://securetoken.googleapis.com"
              ],
              "path": [
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{apiKey}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refreshToken}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.id_token)      pm.environment.set('idToken',      b.id_token);",
                  "if (b.refresh_token) pm.environment.set('refreshToken', b.refresh_token);",
                  "pm.test('200 OK',            () => pm.response.to.have.status(200));",
                  "pm.test('new id_token issued',  () => pm.expect(b.id_token).to.be.a('string'));",
                  "pm.test('refresh_token rotated',() => pm.expect(b.refresh_token).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create my profile (after Register)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{fsBase}}/users/{{uid}}",
              "host": [
                "{{fsBase}}"
              ],
              "path": [
                "users",
                "{{uid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"uid\":      { \"stringValue\": \"{{uid}}\" },\n    \"email\":    { \"stringValue\": \"{{testEmail}}\" },\n    \"fullName\": { \"stringValue\": \"Test User\" },\n    \"role\":     { \"stringValue\": \"customer\" },\n    \"createdAt\":{ \"timestampValue\": \"2026-01-01T00:00:00Z\" }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('doc returned',     () => pm.expect(b.name).to.include('users/' + pm.environment.get('uid')));",
                  "pm.test('role = customer',  () => pm.expect(b.fields.role.stringValue).to.eql('customer'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": {
              "raw": "{{fsBase}}/users/{{uid}}",
              "host": [
                "{{fsBase}}"
              ],
              "path": [
                "users",
                "{{uid}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('fullName persisted', () => pm.expect(b.fields.fullName.stringValue).to.eql('Test User'));",
                  "pm.test('uid matches',        () => pm.expect(b.fields.uid.stringValue).to.eql(pm.environment.get('uid')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List all",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{fsBase}}/products?pageSize=50",
              "host": [
                "{{fsBase}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.documents && b.documents[0]) {",
                  "  pm.environment.set('productId', b.documents[0].name.split('/').pop());",
                  "}",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('catalogue not empty', () => pm.expect(b.documents).to.be.an('array').and.have.length.greaterThan(0));",
                  "pm.test('productId captured',  () => pm.expect(pm.environment.get('productId')).to.be.a('string').and.have.length.greaterThan(0));",
                  "pm.test('pricePerMeter on first doc', () => pm.expect(b.documents[0].fields.pricePerMeter).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{fsBase}}/products/{{productId}}",
              "host": [
                "{{fsBase}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('doc id matches', () => pm.expect(b.name).to.include('products/' + pm.environment.get('productId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by master category (Sarees)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents:runQuery",
              "host": [
                "https://firestore.googleapis.com"
              ],
              "path": [
                "v1",
                "projects",
                "{{projectId}}",
                "databases",
                "(default)",
                "documents:runQuery"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"structuredQuery\": {\n    \"from\": [{ \"collectionId\": \"products\" }],\n    \"where\": {\n      \"fieldFilter\": {\n        \"field\": { \"fieldPath\": \"masterCategory\" },\n        \"op\": \"EQUAL\",\n        \"value\": { \"stringValue\": \"Sarees\" }\n      }\n    },\n    \"limit\": 50\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const arr = pm.response.json();",
                  "pm.test('runQuery returns array', () => pm.expect(arr).to.be.an('array'));",
                  "const hits = arr.filter(r => r.document);",
                  "if (hits.length > 0) {",
                  "  pm.test('masterCategory filter holds', () => hits.forEach(h => pm.expect(h.document.fields.masterCategory.stringValue).to.eql('Sarees')));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{fsBase}}/products",
              "host": [
                "{{fsBase}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"brand\":          { \"stringValue\": \"TRESOR\" },\n    \"name\":           { \"stringValue\": \"Sample Banarasi\" },\n    \"description\":    { \"stringValue\": \"Seeded via Postman.\" },\n    \"pricePerMeter\":  { \"integerValue\": \"4500\" },\n    \"mrpPerMeter\":    { \"integerValue\": \"7999\" },\n    \"photo\":          { \"stringValue\": \"/products/banarasi-purple-1.jpg\" },\n    \"image\":          { \"stringValue\": \"/products/banarasi-purple-1.jpg\" },\n    \"category\":       { \"stringValue\": \"Silk\" },\n    \"masterCategory\": { \"stringValue\": \"Sarees\" },\n    \"subCategory\":    { \"stringValue\": \"Banarasi\" },\n    \"origin\":         { \"stringValue\": \"Varanasi\" },\n    \"tags\":           { \"arrayValue\": { \"values\": [{ \"stringValue\": \"sample\" }] } },\n    \"sticker\":        { \"stringValue\": \"Trending\" },\n    \"inStockMeters\":  { \"integerValue\": \"20\" }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rule denies non-admin create (403)', () => pm.expect(pm.response.code).to.eql(403));",
                  "// Don't propagate productId from a denied response — keep the listed one."
                ]
              }
            }
          ]
        },
        {
          "name": "Update price (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{fsBase}}/products/{{productId}}?updateMask.fieldPaths=pricePerMeter&updateMask.fieldPaths=sticker",
              "host": [
                "{{fsBase}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ],
              "query": [
                {
                  "key": "updateMask.fieldPaths",
