              "raw": "{{fsBase}}/products/{{productId}}",
              "host": [
                "{{fsBase}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rule denies non-admin delete (403)', () => pm.expect(pm.response.code).to.eql(403));"
                ]
              }
            }
          ]
        }
      ]
    },
