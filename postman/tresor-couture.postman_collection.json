            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"pricePerMeter\": { \"integerValue\": \"4800\" },\n    \"sticker\":       { \"stringValue\": \"Bestseller\" }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rule denies non-admin update (403)', () => pm.expect(pm.response.code).to.eql(403));"
                ]
