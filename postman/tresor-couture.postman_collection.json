          "  pm.environment.set('runId', runId);",
          "  pm.environment.set('testEmail',      `postman+${runId}@tresor.test`);",
          "  pm.environment.set('testPassword',   `Pm${runId}!aA`);",
          "  pm.environment.set('secondaryEmail', `postman+${runId}-secondary@tresor.test`);",
