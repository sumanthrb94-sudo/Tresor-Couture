    {
      "name": "Orders",
      "item": [
        {
          "name": "Place order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{fsBase}}/orders",
              "host": [
                "{{fsBase}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"userId\":   { \"stringValue\": \"{{uid}}\" },\n    \"status\":   { \"stringValue\": \"placed\" },\n    \"placedAt\": { \"timestampValue\": \"2026-05-15T00:00:00Z\" },\n    \"paymentMethod\": { \"stringValue\": \"upi\" },\n    \"subtotal\": { \"integerValue\": \"13500\" },\n    \"tax\":      { \"integerValue\": \"675\" },\n    \"shipping\": { \"integerValue\": \"0\" },\n    \"total\":    { \"integerValue\": \"14175\" },\n    \"shippingAddress\": { \"mapValue\": { \"fields\": {\n      \"fullName\":   { \"stringValue\": \"Test User\" },\n      \"email\":      { \"stringValue\": \"{{testEmail}}\" },\n      \"phone\":      { \"stringValue\": \"9876543210\" },\n      \"line1\":      { \"stringValue\": \"Plot 12, Banjara Hills\" },\n      \"city\":       { \"stringValue\": \"Hyderabad\" },\n      \"state\":      { \"stringValue\": \"Telangana\" },\n      \"postalCode\": { \"stringValue\": \"500034\" },\n      \"country\":    { \"stringValue\": \"India\" }\n    }}},\n    \"items\": { \"arrayValue\": { \"values\": [\n      { \"mapValue\": { \"fields\": {\n        \"fabricId\": { \"stringValue\": \"{{productId}}\" },\n        \"meters\":   { \"integerValue\": \"3\" }\n      }}}\n    ]}}\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "if (b.name) pm.environment.set('orderId', b.name.split('/').pop());",
                  "pm.test('200 OK',           () => pm.response.to.have.status(200));",
                  "pm.test('order doc returned',() => pm.expect(b.name).to.include('orders/'));",
                  "pm.test('orderId captured', () => pm.expect(pm.environment.get('orderId')).to.have.length.greaterThan(0));",
                  "pm.test('userId stamped',   () => pm.expect(b.fields.userId.stringValue).to.eql(pm.environment.get('uid')));",
                  "pm.test('status = placed',  () => pm.expect(b.fields.status.stringValue).to.eql('placed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "My orders (runQuery)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents:runQuery",
              "host": [
                "https://firestore.googleapis.com"
              ],
              "path": [
                "v1",
                "projects",
                "{{projectId}}",
                "databases",
                "(default)",
                "documents:runQuery"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"structuredQuery\": {\n    \"from\": [{ \"collectionId\": \"orders\" }],\n    \"where\": {\n      \"fieldFilter\": {\n        \"field\": { \"fieldPath\": \"userId\" },\n        \"op\": \"EQUAL\",\n        \"value\": { \"stringValue\": \"{{uid}}\" }\n      }\n    },\n    \"orderBy\": [{ \"field\": { \"fieldPath\": \"placedAt\" }, \"direction\": \"DESCENDING\" }],\n    \"limit\": 50\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const arr = pm.response.json();",
                  "const docs = arr.filter(r => r.document);",
                  "pm.test('at least one own order',() => pm.expect(docs.length).to.be.greaterThan(0));",
                  "pm.test('all orders are mine',   () => docs.forEach(d => pm.expect(d.document.fields.userId.stringValue).to.eql(pm.environment.get('uid'))));"
                ]
              }
            }
          ]
        },
