rules_version = '2';

// Free-tier security model: no Cloud Functions, so every business rule
// is enforced HERE. Clients read/write Firestore directly via the Web SDK;
// these rules are the entire security boundary.
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function fieldChanged(field) {
      return request.resource.data[field] != resource.data[field];
    }

    /* ---------- products ---------- */
    // Public read · admin write (UI gated to admins via the custom claim).
    match /products/{productId} {
      allow read:   if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['brand', 'name', 'price', 'masterCategory', 'category'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ---------- coupons ---------- */
    // Code is the document ID. NOT publicly readable — a world-readable coupon
    // collection leaks every code, value and threshold. Checkout validates a
    // code via the server (/api/coupons/validate, Admin SDK) which returns only
    // the resulting discount. Admin manages coupons in-console.
    match /coupons/{code} {
      allow read, write: if isAdmin();
    }

    /* ---------- users ---------- */
    // Owner reads + updates their own profile. Role and createdAt are
    // protected — only admins can change them.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer'
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['email', 'fullName', 'role']);
      allow update: if (isOwner(userId)
                        && !fieldChanged('role')
                        && !fieldChanged('uid')
                        && !fieldChanged('createdAt'))
                     || isAdmin();
      allow delete: if isAdmin();
    }

    /* ---------- orders ---------- */
    // An order belongs to the signed-in user; admin sees everything.
    // Creation must include the authenticated uid, an initial 'placed'
    // status, and at least one item. Updates are admin-only (fulfilment).
    // Two creation paths: (1) CLIENT (Web SDK) for COD/demo orders, subject to
    // these rules — a client may NEVER self-assert paymentStatus 'paid'.
    // (2) SERVER (Admin SDK, /api/payments/verify) for real Razorpay orders,
    // which bypasses rules and is the only path that may set 'paid', record
    // payment ids and decrement stock, all after signature + amount checks.
    function validPaymentStatus() {
      return !('paymentStatus' in request.resource.data)
        || request.resource.data.paymentStatus in ['pending', 'cod', 'unpaid'];
    }
    // A client-written order's total is computed in the browser and therefore
    // untrusted. It may NOT claim to be amount-verified — only the server
    // (Admin SDK, /api/orders/place + /api/payments/verify, which bypass these
    // rules) can set amountVerified:true after recomputing the total. Invoices
    // and revenue reports trust that flag.
    function clientAmountUnverified() {
      return !('amountVerified' in request.resource.data)
        || request.resource.data.amountVerified == false;
    }
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && validPaymentStatus()
        && clientAmountUnverified();
      allow update, delete: if isAdmin();
    }

    /* ---------- reviews ---------- */
    // Anyone signed-in can submit a review for any product. Reviews go
    // into 'pending' for admin moderation. Owner can delete their own;
    // admin can do anything.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    /* ---------- carts ---------- */
    // Each signed-in user owns exactly one cart doc keyed by their uid.
    // Used by CartContext to sync the bag across devices; guests stay on
    // localStorage. No public read — carts are private to the owner.
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    /* ---------- mail (Firebase Trigger Email extension) ---------- */
    // Outbound email queue. The `firestore-send-email` extension watches
    // this collection and POSTs each new doc to the configured SMTP
    // provider. Security model:
    //   - Customers may enqueue mail addressed ONLY to their own email
    //     (prevents using the queue to spam arbitrary recipients).
    //   - Admin may enqueue, read, update, delete anything (status-change
    //     emails, manual replies, queue clean-up).
    //   - No public read — the queue can contain customer order details.
    // Transactional mail is now enqueued SERVER-SIDE (escaped, templated — see
    // /api/email/*) or by admin (status emails). Customers may NOT write to the
    // queue directly: a client-writable mail doc lets a user send arbitrary
    // HTML from our verified sending domain (to themselves), a needless
    // reputation/abuse vector. Admin-only.
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    /* ---------- admin_notifications ---------- */
    // In-app notifications surfaced in the admin dashboard ("new order" alerts).
    // Written SERVER-SIDE now (Admin SDK, /api/orders/place + payments/verify),
    // so this is admin-only: a signed-in customer must not be able to flood the
    // admin inbox with forged alerts. (The client fallback path's best-effort
    // write degrades silently when the server is unavailable.)
    match /admin_notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    /* ---------- payment_events ---------- */
    // Orphan/unmatched gateway payments, written server-side (Admin SDK) by the
    // webhook for manual reconciliation. Admin-readable so they can surface in
    // the console; never client-writable.
    match /payment_events/{eventId} {
      allow read: if isAdmin();
    }

    /* ---------- consents (DPDP / cookie + marketing consent) ---------- */
    // One consent record per signed-in user, keyed by uid. The owner writes
    // their own choices (cookie/marketing acceptance + timestamp); admins read
    // all for the compliance register. No public read — consent logs are PII.
    // Guests' consent stays in localStorage until they sign in.
    match /consents/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    /* ---------- deny everything else ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
