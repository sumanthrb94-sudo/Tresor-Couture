rules_version = '2';

// Free-tier security model: no Cloud Functions, so every business rule
// is enforced HERE. Clients read/write Firestore directly via the Web SDK;
// these rules are the entire security boundary.
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function fieldChanged(field) {
      return request.resource.data[field] != resource.data[field];
    }
    function priceOf(productId) {
      return get(/databases/$(database)/documents/products/$(productId)).data.price;
    }

    /* ---------- products ---------- */
    // Public read · admin write (UI gated to admins via the custom claim).
    match /products/{productId} {
      allow read:   if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['brand', 'name', 'price', 'masterCategory', 'category'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ---------- coupons ---------- */
    // Code is the document ID. Public read so the checkout can validate;
    // admin-only write.
    match /coupons/{code} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* ---------- users ---------- */
    // Owner reads + updates their own profile. Role and createdAt are
    // protected — only admins can change them.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer'
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['email', 'fullName', 'role']);
      allow update: if (isOwner(userId)
                        && !fieldChanged('role')
                        && !fieldChanged('uid')
                        && !fieldChanged('createdAt'))
                     || isAdmin();
      allow delete: if isAdmin();
    }

    /* ---------- orders ---------- */
    // An order belongs to the signed-in user; admin sees everything.
    // Creation must include the authenticated uid, an initial 'placed'
    // status, and at least one item. Updates are admin-only (fulfilment).
    // Two creation paths: (1) CLIENT (Web SDK) for COD/demo orders, subject to
    // these rules — a client may NEVER self-assert paymentStatus 'paid'.
    // (2) SERVER (Admin SDK, /api/payments/verify) for real Razorpay orders,
    // which bypasses rules and is the only path that may set 'paid', record
    // payment ids and decrement stock, all after signature + amount checks.
    function validPaymentStatus() {
      return !('paymentStatus' in request.resource.data)
        || request.resource.data.paymentStatus in ['pending', 'cod', 'unpaid'];
    }
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && validPaymentStatus();
      allow update, delete: if isAdmin();
    }

    /* ---------- reviews ---------- */
    // Anyone signed-in can submit a review for any product. Reviews go
    // into 'pending' for admin moderation. Owner can delete their own;
    // admin can do anything.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    /* ---------- carts ---------- */
    // Each signed-in user owns exactly one cart doc keyed by their uid.
    // Used by CartContext to sync the bag across devices; guests stay on
    // localStorage. No public read — carts are private to the owner.
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    /* ---------- mail (Firebase Trigger Email extension) ---------- */
    // Outbound email queue. The `firestore-send-email` extension watches
    // this collection and POSTs each new doc to the configured SMTP
    // provider. Security model:
    //   - Customers may enqueue mail addressed ONLY to their own email
    //     (prevents using the queue to spam arbitrary recipients).
    //   - Admin may enqueue, read, update, delete anything (status-change
    //     emails, manual replies, queue clean-up).
    //   - No public read — the queue can contain customer order details.
    match /mail/{mailId} {
      allow create: if (isSignedIn()
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.to is string
                        && request.resource.data.to == request.auth.token.email)
                     || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    /* ---------- admin_notifications ---------- */
    // In-app notifications surfaced in the admin dashboard. Today this is
    // the channel for "new order" alerts (Cloud Functions can later
    // promote these to outbound email so the admin doesn't need to poll
    // the console). Any signed-in user can append (i.e. an order created
    // by a customer can drop a notification), but only for whitelisted
    // kinds — no arbitrary writes.
    match /admin_notifications/{notifId} {
      allow create: if isSignedIn()
        && request.resource.data.kind in ['new_order'];
      allow read, update, delete: if isAdmin();
    }

    /* ---------- deny everything else ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
